# Secrets — never commit your real key
.env

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/

# Workspace-local persistent harness state
.coding-agent/
**/run-artifacts/.ultra-staging/
run-artifacts/*.log

# Local browser automation state and disposable captures
.playwright-cli/
output/playwright/
output/browser/
projects/*/output/playwright/
projects/*/output/browser/

# Generated experiment transcripts and replay inputs
output/**/*.stderr.log
output/**/*.stdout.log
output/**/*-input.txt
output/**/*.log.pid

# Per-run diagnostics (published evidence already tracked stays tracked)
projects/*/run-artifacts/
run-artifacts/*.err
run-artifacts/*.out

# One-off local state inspection helpers
projects/*/check_state.py

# Metadata-only standalone experiment repositories
/projects/hill-climb-gemma4/
/projects/hill-climb-gemma4-final/
/projects/hill-climb-gemma4-final-v2/
/projects/hill-climb-gemma4-final-v3/
/projects/project-095/
